<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consulta de Credenciales AVANZO 2026 - INTI</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <!-- Header Institucional -->
  <header class="bg-indigo-900 text-white shadow-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-3">
      <div class="flex items-center gap-3 text-center sm:text-left">
        <div class="bg-white p-2 rounded-lg text-indigo-900 shadow-sm">
          <i class="fa-solid fa-graduation-cap text-2xl"></i>
        </div>
        <div>
          <h1 class="text-xl font-bold tracking-tight">INTI - Credenciales AVANZO 2026</h1>
          <p class="text-xs text-indigo-200">Instituto Nacional Técnico Industrial • San Salvador</p>
        </div>
      </div>
      <div class="flex items-center gap-2 bg-indigo-800/80 px-3 py-1.5 rounded-full text-xs font-medium border border-indigo-700">
        <i class="fa-solid fa-shield-halved text-emerald-400"></i>
        <span>Portal de Consulta Oficial</span>
      </div>
    </div>
  </header>

  <!-- Contenido Principal -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- Mensaje Toast de Notificación -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none bg-slate-900 text-white px-4 py-3 rounded-xl shadow-2xl flex items-center gap-3 border border-slate-700">
      <i class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
      <span id="toast-msg" class="text-sm font-medium">Copiado al portapapeles</span>
    </div>

    <!-- Panel de Búsqueda y Filtros -->
    <section class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 mb-6">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
        
        <!-- Búsqueda Principal por NIE o Nombre -->
        <div class="md:col-span-5 relative">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Buscar Estudiante</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
              <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <input type="text" id="search-input" placeholder="Escribe NIE, Nombre o Apellido..." class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-300 text-slate-900 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all shadow-sm">
          </div>
        </div>

        <!-- Filtro Especialidad -->
        <div class="md:col-span-4">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Especialidad / Opción</label>
          <select id="option-select" class="w-full py-2.5 px-3 bg-slate-50 border border-slate-300 text-slate-900 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all shadow-sm">
            <option value="">Todas las especialidades</option>
            <option value="ELECTRÓNICA">Electrónica</option>
            <option value="INFRA. TEC. Y SERVICIOS INF.">Infraestructura Tecnológica</option>
            <option value="DESARROLLO DE SOFTWARE">Desarrollo de Software</option>
            <option value="MANTENIMIENTO AUTOMOTRIZ">Mantenimiento Automotriz</option>
            <option value="MECÁNICA INDUSTRIAL">Mecánica Industrial</option>
            <option value="SISTEMAS ELÉCTRICOS Y ENERGIAS REN">Sistemas Eléctricos / Energías Renovables</option>
          </select>
        </div>

        <!-- Filtro Sección -->
        <div class="md:col-span-2">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Sección</label>
          <select id="section-select" class="w-full py-2.5 px-3 bg-slate-50 border border-slate-300 text-slate-900 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all shadow-sm">
            <option value="">Todas</option>
            <option value="A">Sección A</option>
            <option value="B">Sección B</option>
            <option value="C">Sección C</option>
            <option value="D">Sección D</option>
            <option value="E">Sección E</option>
            <option value="F">Sección F</option>
            <option value="G">Sección G</option>
            <option value="H">Sección H</option>
            <option value="I">Sección I</option>
          </select>
        </div>

        <!-- Botón Limpiar -->
        <div class="md:col-span-1 flex items-end">
          <button id="btn-reset" title="Limpiar filtros" class="w-full py-2.5 px-3 bg-slate-100 hover:bg-slate-200 text-slate-600 font-medium rounded-xl transition-all duration-200 flex items-center justify-center gap-2 text-sm border border-slate-300">
            <i class="fa-solid fa-rotate-left"></i>
            <span class="md:hidden">Limpiar</span>
          </button>
        </div>

      </div>

      <!-- Barra de Resumen e Indicador de Resultados -->
      <div class="mt-4 pt-4 border-t border-slate-100 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500 gap-2">
        <div>
          Mostrando <span id="results-count" class="font-bold text-indigo-700 text-sm">222</span> de <span class="font-semibold text-slate-700">222</span> estudiantes cargados.
        </div>
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 font-medium">
            <i class="fa-regular fa-clock"></i> Prueba: 28 y 29 de Octubre 2026
          </span>
        </div>
      </div>
    </section>

    <!-- Listado / Grilla de Tarjetas de Estudiantes -->
    <section id="students-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- Tarjetas generadas dinámicamente mediante JS -->
    </section>

    <!-- Estado Vacío (Sin Resultados) -->
    <div id="no-results" class="hidden text-center py-16 bg-white rounded-2xl border border-dashed border-slate-300 mt-4">
      <div class="w-16 h-16 bg-indigo-50 text-indigo-500 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
        <i class="fa-solid fa-user-slash"></i>
      </div>
      <h3 class="text-base font-bold text-slate-800">No se encontraron estudiantes</h3>
      <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">Verifica el número de NIE, los nombres o restablece los filtros de búsqueda.</p>
      <button onclick="resetFilters()" class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg shadow-sm transition-all">
        <i class="fa-solid fa-rotate-left"></i> Restablecer Filtros
      </button>
    </div>

  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-slate-200 mt-auto py-4">
    <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500 flex flex-col sm:flex-row justify-between items-center gap-2">
      <p>© 2026 Instituto Nacional Técnico Industrial (INTI). Uso Exclusivo Educativo.</p>
      <p class="text-slate-400">Plataforma MINED: <a href="https://evaluaciones.mined.gob.sv" target="_blank" class="text-indigo-600 hover:underline">evaluaciones.mined.gob.sv</a></p>
    </div>
  </footer>

