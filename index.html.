      [19850091, "RODRÍGUEZ DIMAS", "JOSÉ EDUARDO", "19850091@clases.edu.sv", "STF56G", "SISTEMAS ELÉCTRICOS Y ENERGIAS REN", "A"],
      [5359971, "RODRÍGUEZ HENRÍQUEZ", "JOSÉ HUMBERTO", "5359971@clases.edu.sv", "HHBWXT", "SISTEMAS ELÉCTRICOS Y ENERGIAS REN", "A"],
      [2893960, "SÁNCHEZ ASCENCIO", "STEVEN GERARD", "2893960@clases.edu.sv", "AV4V4M", "SISTEMAS ELÉCTRICOS Y ENERGIAS REN", "A"],
      [5451286, "SÁNCHEZ SÁNCHEZ", "GERSON EDENILSON", "5451286@clases.edu.sv", "HLDQMJ", "SISTEMAS ELÉCTRICOS Y ENERGIAS REN", "A"],
      [19961488, "VÁSQUEZ GARCÍA", "JOSÉ SAMUEL", "19961488@clases.edu.sv", "W1KSQ3", "SISTEMAS ELÉCTRICOS Y ENERGIAS REN", "A"],
      [5684463, "VIDALES RODRÍGUEZ", "JOHANA MARISOL", "5684463@clases.edu.sv", "J7QYX2", "SISTEMAS ELÉCTRICOS Y ENERGIAS REN", "A"],
      [19881860, "VILLANUEVA MEJÍA", "NAARA MADAI", "19881860@clases.edu.sv", "TMF9CO", "SISTEMAS ELÉCTRICOS Y ENERGIAS REN", "A"]
    ];

    // Mapeo de objetos
    const students = rawStudentsData.map((item) => ({
      nie: item[0].toString(),
      apellidos: item[1],
      nombres: item[2],
      usuario: item[3],
      pass: item[4],
      opcion: item[5],
      seccion: item[6]
    }));

    // Referencias al DOM
    const searchInput = document.getElementById('search-input');
    const optionSelect = document.getElementById('option-select');
    const sectionSelect = document.getElementById('section-select');
    const btnReset = document.getElementById('btn-reset');
    const studentsGrid = document.getElementById('students-grid');
    const resultsCount = document.getElementById('results-count');
    const noResults = document.getElementById('no-results');

    // Función principal de renderizado
    function renderStudents(data) {
      studentsGrid.innerHTML = '';
      resultsCount.textContent = data.length;

      if (data.length === 0) {
        noResults.classList.remove('hidden');
        studentsGrid.classList.add('hidden');
        return;
      } else {
        noResults.classList.add('hidden');
        studentsGrid.classList.remove('hidden');
      }

      data.forEach((student) => {
        const card = document.createElement('div');
        card.className = "bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition-all duration-200 p-5 flex flex-col justify-between relative overflow-hidden group";
        
        card.innerHTML = `
          <div>
            <!-- Header Tarjeta -->
            <div class="flex justify-between items-start mb-3 gap-2">
              <div>
                <span class="text-[10px] font-bold tracking-wider uppercase bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-md border border-indigo-100">
                  Sec. ${student.seccion}
                </span>
                <p class="text-xs text-slate-400 mt-1 font-mono">NIE: <span class="font-bold text-slate-600">${student.nie}</span></p>
              </div>
              <span class="text-[11px] font-medium text-slate-500 bg-slate-100 px-2.5 py-1 rounded-full text-right truncate max-w-[150px]" title="${student.opcion}">
                ${student.opcion}
              </span>
            </div>

            <!-- Nombre Estudiante -->
            <h3 class="text-base font-bold text-slate-900 group-hover:text-indigo-600 transition-colors line-clamp-1">
              ${student.apellidos}
            </h3>
            <p class="text-sm font-medium text-slate-600 mb-4 line-clamp-1">
              ${student.nombres}
            </p>

            <!-- Datos de Acceso -->
            <div class="space-y-2 bg-slate-50 p-3 rounded-xl border border-slate-100 text-xs">
              <div class="flex items-center justify-between text-slate-600">
                <span class="text-slate-400"><i class="fa-regular fa-envelope mr-1.5"></i>Usuario:</span>
                <span class="font-mono text-slate-800 font-semibold select-all truncate max-w-[180px]">${student.usuario}</span>
              </div>
              <div class="flex items-center justify-between pt-1 border-t border-slate-200/60">
                <span class="text-slate-400"><i class="fa-solid fa-key mr-1.5"></i>Contraseña:</span>
                <span class="font-mono text-indigo-900 font-bold text-sm bg-indigo-100/70 px-2 py-0.5 rounded tracking-wide">${student.pass}</span>
              </div>
            </div>
          </div>

          <!-- Acciones -->
          <div class="mt-4 pt-3 border-t border-slate-100 flex gap-2">
            <button onclick="copyToClipboard('${student.pass}', 'Contraseña del estudiante ${student.nombres}')" class="flex-1 py-2 px-3 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 shadow-sm">
              <i class="fa-regular fa-copy"></i> Copiar Clave
            </button>
            <button onclick="copyToClipboard('${student.usuario}', 'Usuario de ${student.nombres}')" title="Copiar Usuario" class="py-2 px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition-all flex items-center justify-center border border-slate-200">
              <i class="fa-solid fa-at"></i>
            </button>
          </div>
        `;
        studentsGrid.appendChild(card);
      });
    }

    // Filtrado Dinámico
    function filterStudents() {
      const query = searchInput.value.toLowerCase().trim();
      const selectedOption = optionSelect.value;
      const selectedSection = sectionSelect.value;

      const filtered = students.filter((s) => {
        const matchesQuery = 
          s.nie.includes(query) ||
          s.apellidos.toLowerCase().includes(query) ||
          s.nombres.toLowerCase().includes(query) ||
          `${s.nombres} ${s.apellidos}`.toLowerCase().includes(query) ||
          `${s.apellidos} ${s.nombres}`.toLowerCase().includes(query);

        const matchesOption = selectedOption === '' || s.opcion === selectedOption;
        const matchesSection = selectedSection === '' || s.seccion === selectedSection;

        return matchesQuery && matchesOption && matchesSection;
      });

      renderStudents(filtered);
    }

    // Función de Copiado con Fallback seguro
    function copyToClipboard(text, label) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(() => {
          showToast(`¡Copiado! (${text})`);
        }).catch(() => {
          legacyCopy(text);
        });
      } else {
        legacyCopy(text);
      }
    }

    function legacyCopy(text) {
      const textArea = document.createElement("textarea");
      textArea.value = text;
      textArea.style.position = "fixed";
      textArea.style.left = "-999999px";
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        document.execCommand('copy');
        showToast(`¡Copiado! (${text})`);
      } catch (err) {
        showToast("Error al copiar");
      }
      document.body.removeChild(textArea);
    }

    // Toast de Confirmación
    function showToast(message) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toast-msg');
      toastMsg.textContent = message;
      toast.classList.remove('translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 2500);
    }

    // Limpieza de Filtros
    function resetFilters() {
      searchInput.value = '';
      optionSelect.value = '';
      sectionSelect.value = '';
      filterStudents();
    }

    // Event Listeners
    searchInput.addEventListener('input', filterStudents);
    optionSelect.addEventListener('change', filterStudents);
    sectionSelect.addEventListener('change', filterStudents);
    btnReset.addEventListener('click', resetFilters);

    // Inicialización
    window.onload = function() {
      renderStudents(students);
    };
  </script>
